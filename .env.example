# Copy to .env and fill in to enable live AI + SMS.
# The app runs fully in demo mode if these are left unset.

PORT=3000
DB_PATH=./data/valet.db

# Public base URL of your deployment, e.g. https://valet.example.com
# Used to build the QR/share links printed on tickets. If unset, it is
# derived from the incoming request.
PUBLIC_BASE_URL=

# --- Accounts ---
# The FIRST account is always allowed (bootstrap admin). If SIGNUP_CODE is
# set, any additional self-signups must provide this code. Leave blank for
# open signup.
SIGNUP_CODE=

# --- AI vehicle recognition (Google Gemini Flash vision) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- SMS (Twilio) ---
# https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15550001111
# Point your Twilio number's inbound-message webhook (POST) to:
#   https://YOUR_PUBLIC_HOST/api/sms/inbound
